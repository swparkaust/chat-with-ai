# AI Provider selection (gemini | anthropic | ollama | openai; defaults to 'gemini').
# A database AiProvider record, when present, overrides this.
# AI_PROVIDER=gemini

# Gemini (the default provider)
GEMINI_API_KEY=your-gemini-api-key-here
# Single model for both routing tiers:
GEMINI_MODEL=gemini-2.5-flash
# Or split by tier (advanced = generation-quality tasks, standard = mechanical tasks):
# GEMINI_ADVANCED_MODEL=gemini-2.5-pro
# GEMINI_STANDARD_MODEL=gemini-2.5-flash

# Anthropic (AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Ollama (AI_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434

# OpenAI or any OpenAI-compatible endpoint (AI_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_ADVANCED_MODEL=gpt-4o
# OPENAI_STANDARD_MODEL=gpt-4o-mini

# Redis Configuration (optional, defaults to localhost:6379)
# REDIS_URL=redis://localhost:6379/0

# Database Configuration (optional, uses config/database.yml by default)
# DATABASE_URL=postgresql://localhost/chat_with_ai_development

# Web Push Notifications (for PWA)
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_SUBJECT=mailto:you@example.com

# Frontend origin allowed by CORS in production (defaults to http://localhost:3000)
# FRONTEND_URL=https://app.example.com

# Application Version (optional)
# APP_VERSION=1.0.0

# Public URL of this backend, used to build attachment/notification URLs
# outside request context (optional in development, required in production)
# BACKEND_URL=http://localhost:3001
